#Installing the neccessary packages
library(tidyverse)
library(janitor)
library(ggplot2)

#Loading and cleansing data sets
continents <- read.csv("data sets/continents-according-to-our-world-in-data.csv") %>% clean_names()
gdp <- read.csv("data sets/gdp-per-capita-worldbank.csv") %>% clean_names()

names (gdp)
head(gdp)

# Combining data sets
comb_gdp <- gdp %>%
  select(entity, code, year,gdp_per_capita_ppp_constant_2017_international) %>%
  left_join(continents %>% select(code, continent),by = "code")

# Computation of GDP per capita growth
comb_growth <- comb_gdp %>%
  group_by(entity) %>%
  arrange(year) %>%
  mutate(growth_rate = (gdp_per_capita_ppp_constant_2017_international -lag(gdp_per_capita_ppp_constant_2017_international)) /lag(gdp_per_capita_ppp_constant_2017_international) * 100
  ) %>%
  ungroup()

# GDP growth (continents)
cont_growth <- comb_growth %>%
  group_by(continent, year) %>%
  summarise(mean_growth = mean(growth_rate, na.rm = TRUE)) %>%
  ungroup()

#Plotting graphs only involving given data sets
ggplot(cont_growth, aes(x = year, y = mean_growth, color = continent)) +
  geom_line(linewidth = 0.7, alpha = 0.85) + geom_point(size = 1.3, alpha = 0.9) +
  labs(title = "GDP Per Capita Growth Across Continents", x = "Year", y = "Average Growth (%)",color = "Continent") +
  theme_minimal(base_size = 14) +
  theme(legend.position = "bottom", panel.grid.minor = element_blank()
  )

#Combining everything with new data set

income <- read.csv("data sets/CLASS_2025_10_07.csv") %>% clean_names()

comb_gdp2 <- comb_gdp %>%
  left_join(income %>% select(code, income_group, lending_category), by = "code")
comb_gdp2 <- comb_gdp2 %>%
  mutate(ldc = if_else(income_group == "Low income", "LDC Countries", "Non-LDC Countries"))

comb_growth2 <- comb_gdp2 %>%
  group_by(entity) %>%
  arrange(year) %>%
  mutate(growth_rate =
           (gdp_per_capita_ppp_constant_2017_international - lag(gdp_per_capita_ppp_constant_2017_international)) / lag(gdp_per_capita_ppp_constant_2017_international) * 100) %>%
  ungroup()

# Continent-level growth (Inc 4th CSV)
cont_growth2 <- comb_growth2 %>%
  group_by(continent, year) %>%
  summarise(mean_growth = mean(growth_rate, na.rm = TRUE)) %>%
  ungroup()

# LDC-only growth
ldc_growth <- comb_growth2 %>%
  filter(ldc == "LDC Countries") %>%
  group_by(continent, year) %>%
  summarise(mean_growth = mean(growth_rate, na.rm = TRUE)) %>%
  ungroup()

# Gap to 7% target
ldc_gap <- ldc_growth %>%
  mutate(gap_to_target = mean_growth - 7)

#Plot 1
ldc_growth <- comb_growth2 %>%
  filter(ldc == "LDC Countries") %>%
  group_by(continent, year) %>%
  summarise(mean_growth = mean(growth_rate, na.rm = TRUE)) %>%
  ungroup()

ldc_gap <- ldc_growth %>%
  mutate(gap_to_target = mean_growth - 7)

p1 <- ggplot(ldc_gap, aes(x = year, y = gap_to_target, fill = continent)) + 
  
  geom_col(alpha = 0.9) +
  
  geom_hline(yintercept = 0, color = "black", linetype = "dashed", linewidth = 1) +
  
  labs(title = "Contribution of Each Continent to Gap From 7% GDP Per Capita Growth Target (LDC Countries)", 
       subtitle = "█ Continent Contribution to Total LDC Growth towards Target", 
       x = "Year", 
       y = "Target Deviation (in %)", fill = "Continent") +

  theme(legend.position = "bottom", panel.grid.minor = element_blank()) + 
  
  theme_minimal(13) +
  
  theme(
    plot.background = element_rect(
      fill = "#F9F9F9", color = NA
    ), 
    panel.background = element_rect(
      fill = "#FFFFFF", color = NA
    ),
    panel.grid.major = element_line(
      color = "#D9D9D9", size = 0.5
    ),
    panel.grid.minor = element_line(
      color = "#EFEFEF", size = 0.25
    ),
    plot.title = element_text(
      size = 11, face = "bold", hjust = 0.5
    ),
    plot.subtitle = element_text(
      size = 10, face = "bold", hjust = 0.5
    ),
    plot.caption = element_text(
      size = 7, hjust = 0
    ),
    axis.title.y = element_text(
      size = 11, face = "bold"
    ),
    axis.title.x = element_text(
      size = 11, face = "bold"
    ),
    legend.position = "right",
    legend.title = element_text(
      size = 11, face = "bold"
    ),
    legend.text = element_text(
      size = 11
    ) 
  )

plot(p1)

#Plot 2
income_stats <- comb_growth2 %>%
  group_by(income_group) %>%
  summarise(avg_growth = mean(growth_rate, na.rm = TRUE), volatility = sd(growth_rate, na.rm = TRUE), .groups = "drop" )

scale_factor <- max(income_stats$avg_growth, na.rm = TRUE) /
  max(income_stats$volatility, na.rm = TRUE)

p2 <- ggplot(income_stats 
             %>% filter(!is.na(income_group)) %>% 
                          filter(income_group != ""),
             aes(x = income_group)) +
  
  geom_col(aes(y = avg_growth, fill = income_group), alpha = 0.8) +
  
  geom_line(aes(y = volatility * scale_factor, group = 1), 
            color = "black", linewidth = 0.7) +
  
  geom_point(aes(y = volatility * scale_factor),color = "black", size = 3) +
  
  scale_y_continuous(
    name = "Average GDP Per Capita Growth (%)", 
    sec.axis = sec_axis(~ . / scale_factor, name = "Volatility (Standard Deviation)")) +
  
  labs(title = "National Income Growth and Volatility Across Income Groups", 
        subtitle = "█ Average National Income Growth   — Volatility", 
        x = "Income Group", fill = "Income Group") +
  theme_minimal(13) +
  
  theme(
    plot.background = element_rect(
      fill = "#F9F9F9", color = NA
    ), 
    panel.background = element_rect(
      fill = "#FFFFFF", color = NA
    ),
    panel.grid.major = element_line(
      color = "#D9D9D9", size = 0.5
    ),
    panel.grid.minor = element_line(
      color = "#EFEFEF", size = 0.25
    ),
    plot.title = element_text(
      size = 12, face = "bold", hjust = 0.5
    ),
    plot.subtitle = element_text(
      size = 10, face = "bold", hjust = 0.5
    ),
    plot.caption = element_text(
      size = 7, hjust = 0
    ),
    axis.title.y = element_text(
      size = 11, face = "bold"
    ),
    axis.title.x = element_text(
      size = 11, face = "bold"
    ),
    legend.position = "right",
    legend.title = element_text(
      size = 11, face = "bold"
    ),
    legend.text = element_text(
      size = 11
    ) 
  ) +
  
  theme(legend.position = "none")

plot(p2)

